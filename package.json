{
  "name": "agent-commander",
  "version": "0.1.0",
  "description": "Minimal Telegram agent runtime on OpenRouter",
  "license": "MIT",
  "type": "module",
  "bin": {
    "acmd": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "start": "node dist/main.js",
    "status": "tsx src/main.ts status",
    "test": "vitest run",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@openrouter/agent": "0.11.0",
    "@openrouter/sdk": "0.13.67",
    "grammy": "^1.46.0",
    "marked": "^18.1.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
